                Tween(LoginFrame, { Size = LoginFrame.Size - UDim2.new(0, 20, 0, 20) }, 0.25)
                tw.Completed:Connect(function()
                    LoginFrame:Destroy()
                end)
                ToggleButton.Visible = true
                Window:Notify({ Title = "Giriş Başarılı", Content = "Hoş geldin, " .. uname .. "!", Duration = 3 })
                Window:Show()
            else
                PlaySound(Sounds.Error, 0.5)
                ErrorLabel.Text = "Kullanıcı adı veya anahtar hatalı!"
                ShakeFrame(LoginFrame)
            end
        end

        LoginButton.MouseButton1Click:Connect(AttemptLogin)
        KeyBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then AttemptLogin() end
        end)

        MakeDraggable(LoginFrame, LoginFrame)
    else
        Window:Show()
    end


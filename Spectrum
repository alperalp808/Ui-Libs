                local Default = cfg.Default or Color3.new(1, 1, 1)
                local Callback = cfg.Callback or function() end
                local Notifications = cfg.Notifications

                local h, s, v = Default:ToHSV()
                local Hue, Sat, Val = h, s, v

                local Frame = BaseElement(36)
                NameLabel(Frame, Name)

                local Swatch = Create("TextButton", {
                    Size = UDim2.new(0, 36, 0, 20),
                    Position = UDim2.new(1, -46, 0.5, -10),
                    BackgroundColor3 = Default,
                    Text = "",
                    AutoButtonColor = false,
                    Parent = Frame,
                })
                Themed(Stroke(Swatch, Theme.Stroke, 1, 0.2), "Color", "Stroke")

                local Panel = Create("Frame", {
                    Size = UDim2.new(0, 220, 0, 150),
                    Position = UDim2.new(0, 0, 0, 0),
                    BackgroundColor3 = Theme.Secondary,
                    BackgroundTransparency = 0.05,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 60,
                    Parent = Overlay,
                })
                Themed(Panel, "BackgroundColor3", "Secondary")
                Themed(Stroke(Panel, Theme.Stroke, 1, 0.2), "Color", "Stroke")
                Pad(Panel, 10, 10, 10, 10)

                local SVBox = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 90),
                    BackgroundColor3 = Color3.fromHSV(Hue, 1, 1),
                    BorderSizePixel = 0,
                    ZIndex = 61,
                    Parent = Panel,
                })
                local WhiteGrad = Create("Frame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    ZIndex = 61,
                    Parent = SVBox,
                })
                Create("UIGradient", {
                    Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 1, 1)),
                    Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0),
                        NumberSequenceKeypoint.new(1, 1),
                    }),
                    Parent = WhiteGrad,
                })
                local BlackGrad = Create("Frame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundColor3 = Color3.new(0, 0, 0),
                    BorderSizePixel = 0,
                    ZIndex = 61,
                    Parent = SVBox,
                })
                Create("UIGradient", {
                    Rotation = 90,
                    Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.new(0, 0, 0)),
                    Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1),
                        NumberSequenceKeypoint.new(1, 0),
                    }),
                    Parent = BlackGrad,
                })

                local SVCursor = Create("Frame", {
                    Size = UDim2.new(0, 8, 0, 8),
                    Position = UDim2.new(Sat, -4, 1 - Val, -4),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    ZIndex = 62,
                    Parent = SVBox,
                })
                Stroke(SVCursor, Color3.new(0, 0, 0), 1, 0)

                local HueBar = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 16),
                    Position = UDim2.new(0, 0, 0, 100),
                    BorderSizePixel = 0,
                    ZIndex = 61,
                    Parent = Panel,
                })
                Create("UIGradient", {
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
                        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
                    }),
                    Parent = HueBar,
                })
                local HueCursor = Create("Frame", {
                    Size = UDim2.new(0, 4, 1, 4),
                    Position = UDim2.new(Hue, -2, 0, -2),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    ZIndex = 62,
                    Parent = HueBar,
                })

                local function UpdateColor(silent)
                    local color = Color3.fromHSV(Hue, Sat, Val)
                    Swatch.BackgroundColor3 = color
                    SVBox.BackgroundColor3 = Color3.fromHSV(Hue, 1, 1)
                    if not silent then
                        task.spawn(Callback, color)
                    end
                end

                local svDragging, hueDragging = false, false

                SVBox.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        svDragging = true
                    end
                end)
                HueBar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        hueDragging = true
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        if svDragging or hueDragging then
                            DoNotify(Notifications, "Colorpicker Tetiklendi", Name .. " rengi güncellendi.")
                        end
                        svDragging = false
                        hueDragging = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    if svDragging then
                        local relX = math.clamp((input.Position.X - SVBox.AbsolutePosition.X) / SVBox.AbsoluteSize.X, 0, 1)
                        local relY = math.clamp((input.Position.Y - SVBox.AbsolutePosition.Y) / SVBox.AbsoluteSize.Y, 0, 1)
                        Sat, Val = relX, 1 - relY
                        SVCursor.Position = UDim2.new(Sat, -4, 1 - Val, -4)
                        UpdateColor()
                    elseif hueDragging then
                        local relX = math.clamp((input.Position.X - HueBar.AbsolutePosition.X) / HueBar.AbsoluteSize.X, 0, 1)
                        Hue = relX
                        HueCursor.Position = UDim2.new(Hue, -2, 0, -2)
                        UpdateColor()
                    end
                end)

                Swatch.MouseButton1Click:Connect(function()
                    PlaySound(Sounds.Click, 0.3)
                    if Panel.Visible then
                        ClosePopup(Panel)
                    else
                        OpenPopup(Panel, Swatch, 6, 220, "right")
                    end
                end)

                local API = { Instance = Frame }
                function API:Set(color)
                    local nh, ns, nv = color:ToHSV()
                    Hue, Sat, Val = nh, ns, nv
                    SVCursor.Position = UDim2.new(Sat, -4, 1 - Val, -4)
                    HueCursor.Position = UDim2.new(Hue, -2, 0, -2)
                    UpdateColor()
                end
                function API:Get()
                    return Color3.fromHSV(Hue, Sat, Val)
                end
                return API
            end

            function Section:AddDropdown(cfg)
                cfg = cfg or {}
                local Name = cfg.Name or "Dropdown"
                local Options = cfg.Options or {}
                local Default = cfg.Default
                local Multi = cfg.Multi or false
                local Callback = cfg.Callback or function() end
                local Notifications = cfg.Notifications

                local Selected = Multi and {} or (Default or (Options[1] or nil))
                if Multi and Default then
                    for _, v in ipairs(Default) do Selected[v] = true end
                end

                local Frame = BaseElement(36)
                NameLabel(Frame, Name)

                local DropBtn = Create("TextButton", {
                    Size = UDim2.new(1, -(CONTROL_X + CONTROL_RIGHT_PAD), 0, 24),
                    Position = UDim2.new(0, CONTROL_X, 0.5, -12),
                    BackgroundColor3 = Theme.Secondary,
                    Text = "  " .. (Multi and "Seçiniz..." or tostring(Selected or "Seçiniz...")),
                    Font = Enum.Font.Gotham,
                    TextSize = 11,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    AutoButtonColor = false,
                    Parent = Frame,
                })
                Themed(DropBtn, "BackgroundColor3", "Secondary")
                Themed(DropBtn, "TextColor3", "Text")
                Themed(Stroke(DropBtn, Theme.Stroke, 1, 0.3), "Color", "Stroke")

                local ListFrame = Create("Frame", {
                    Size = UDim2.new(0, 150, 0, 0),
                    Position = UDim2.new(0, 0, 0, 0),
                    BackgroundColor3 = Theme.Secondary,
                    BackgroundTransparency = 0.05,
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Visible = false,
                    ZIndex = 60,
                    Parent = Overlay,
                })
                Themed(ListFrame, "BackgroundColor3", "Secondary")
                Themed(Stroke(ListFrame, Theme.Stroke, 1, 0.2), "Color", "Stroke")
                Create("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = ListFrame,
                })
                Pad(ListFrame, 4, 4, 4, 4)

                local function RefreshText()
                    if Multi then
                        local names = {}
                        for opt, on in pairs(Selected) do
                            if on then table.insert(names, opt) end
                        end
                        DropBtn.Text = "  " .. (#names > 0 and table.concat(names, ", ") or "Seçiniz...")
                    else
                        DropBtn.Text = "  " .. tostring(Selected or "Seçiniz...")
                    end
                end

                local function BuildOptions()
                    for _, c in ipairs(ListFrame:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    for _, opt in ipairs(Options) do
                        local isSel = (Multi and Selected[opt]) or (not Multi and Selected == opt)
                        local OptBtn = Create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 22),
                            BackgroundColor3 = Theme.Tertiary,
                            BackgroundTransparency = isSel and 0.1 or 1,
                            Text = "  " .. tostring(opt),
                            Font = Enum.Font.Gotham,
                            TextSize = 11,
                            TextColor3 = Theme.Text,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            AutoButtonColor = false,
                            ZIndex = 61,
                            Parent = ListFrame,
                        })
                        Themed(OptBtn, "BackgroundColor3", "Tertiary")
                        Themed(OptBtn, "TextColor3", "Text")
                        OptBtn.MouseButton1Click:Connect(function()
                            PlaySound(Sounds.Click, 0.25)
                            if Multi then
                                Selected[opt] = not Selected[opt]
                                OptBtn.BackgroundTransparency = Selected[opt] and 0.1 or 1
                            else
                                Selected = opt
                                ClosePopup(ListFrame)
                            end
                            RefreshText()
                            DoNotify(Notifications, "Dropdown Tetiklendi", Name .. " -> " .. tostring(opt))
                            task.spawn(Callback, Selected)
                        end)
                    end
                end
                BuildOptions()
                RefreshText()

                DropBtn.MouseButton1Click:Connect(function()
                    PlaySound(Sounds.Click, 0.3)
                    if ListFrame.Visible then
                        ClosePopup(ListFrame)
                    else
                        OpenPopup(ListFrame, DropBtn, 4, DropBtn.AbsoluteSize.X, "right")
                    end
                end)

                local API = { Instance = Frame }
                function API:Refresh(newOptions)
                    Options = newOptions
                    BuildOptions()
                end
                function API:Set(value)
                    Selected = value
                    RefreshText()
                    BuildOptions()
                    task.spawn(Callback, Selected)
                end
                function API:Get()
                    return Selected
                end
                return API
            end

            function Section:AddLabel(cfg)
                cfg = cfg or {}
                local Text = cfg.Text or "Label"

                local Frame = BaseElement(28)
                local Lbl = Themed(Create("TextLabel", {
                    Size = UDim2.new(1, -20, 1, 0),
                    Position = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.Gotham,
                    Text = Text,
                    TextColor3 = Theme.SubText,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    Parent = Frame,
                }), "TextColor3", "SubText")

                local API = { Instance = Frame }
                function API:Set(text)
                    Lbl.Text = text
                end
                return API
            end

            table.insert(Tab.Sections, Section)
            return Section
        end

        return Tab
    end

    setmetatable(Window, Window)
    return Window
end

setmetatable(Spectrum, Spectrum)
return Spectrum

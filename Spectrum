        Corner(NotifFrame, 8)
        Stroke(NotifFrame, Theme.Accent, 1, 0.4)
        Pad(NotifFrame, 12, 10, 12, 10)

        local Layout = Create("UIListLayout", {
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = NotifFrame,
        })

        Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 18),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold,
            Text = Title,
            TextColor3 = Theme.Text,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = NotifFrame,
        })
        Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Font = Enum.Font.Gotham,
            Text = Content,
            TextColor3 = Theme.SubText,
            TextSize = 12,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = NotifFrame,
        })

        NotifFrame.Position = UDim2.new(1.3, 0, 0, 0)
        PlaySound(Sounds.Notify, 0.35)
        Tween(NotifFrame, { Position = UDim2.new(0, 0, 0, 0) }, 0.3, Enum.EasingStyle.Quart)

        task.delay(Duration, function()
            if NotifFrame and NotifFrame.Parent then
                local tw = Tween(NotifFrame, { Position = UDim2.new(1.3, 0, 0, 0) }, 0.25, Enum.EasingStyle.Quart)
                tw.Completed:Connect(function()
                    NotifFrame:Destroy()
                end)
            end
        end)
    end

    local function DoNotify(elementNotifSetting, title, content)
        local shouldNotify = elementNotifSetting
        if shouldNotify == nil then shouldNotify = true end
        if shouldNotify and Window.GlobalNotifications then
            Window:Notify({ Title = title, Content = content, Duration = 2.5 })

                    conn = UserInputService.InputBegan:Connect(function(input, processed)
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            CurrentKey = input.KeyCode
                            KeyBtn.Text = CurrentKey.Name
                            Listening = false
                            DoNotify(Notifications, "Keybind Ayarlandı", Name .. " -> " .. CurrentKey.Name)
                            conn:Disconnect()
                        end
                    end)
                end)

                UserInputService.InputBegan:Connect(function(input, processed)
                    if processed or Listening then return end
                    if input.KeyCode == CurrentKey and CurrentKey ~= Enum.KeyCode.Unknown then
                        ClickBounce(KeyBtn)
                        DoNotify(Notifications, "Keybind Tetiklendi", Name .. " (" .. CurrentKey.Name .. ") tetiklendi.")
                        task.spawn(Callback, CurrentKey)
                    end
                end)

                local API = { Instance = Frame }
                function API:Set(keyCode)
                    CurrentKey = keyCode
                    KeyBtn.Text = keyCode.Name
                end
                function API:Get()
                    return CurrentKey
                end
                return API
            end

            --=====================================================
            -- SLIDER
            --=====================================================
            function Section:AddSlider(cfg)
                cfg = cfg or {}
                local Name = cfg.Name or "Slider"
                local Min = cfg.Min or 0
                local Max = cfg.Max or 100
                local Default = cfg.Default or Min
                local Increment = cfg.Increment or 1
                local Callback = cfg.Callback or function() end
                local Notifications = cfg.Notifications
                local Value = Default

                local Frame = BaseElement(46)
                Create("TextLabel", {
                    Size = UDim2.new(1, -60, 0, 20),
                    Position = UDim2.new(0, 12, 0, 4),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.GothamMedium,
                    Text = Name,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Frame,
                })
                local ValueLabel = Create("TextLabel", {
                    Size = UDim2.new(0, 50, 0, 20),
                    Position = UDim2.new(1, -58, 0, 4),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.GothamMedium,
                    Text = tostring(Value),
                    TextColor3 = Theme.SubText,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = Frame,
                })

                local Track = Create("Frame", {
                    Size = UDim2.new(1, -24, 0, 6),
                    Position = UDim2.new(0, 12, 0, 30),
                    BackgroundColor3 = Theme.Stroke,
                    BorderSizePixel = 0,
                    Parent = Frame,
                })
                Corner(Track, 3)
                local Fill = Create("Frame", {
                    Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0,
                    Parent = Track,
                })
                Corner(Fill, 3)
                local Knob = Create("Frame", {
                    Size = UDim2.new(0, 12, 0, 12),
                    Position = UDim2.new((Value - Min) / (Max - Min), -6, 0.5, -6),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    Parent = Track,
                })
                Corner(Knob, 6)

                local function SetValue(alpha, silent)
                    alpha = math.clamp(alpha, 0, 1)
                    local raw = Min + (Max - Min) * alpha
                    raw = math.floor(raw / Increment + 0.5) * Increment
                    raw = math.clamp(raw, Min, Max)
                    Value = raw
                    local a = (Value - Min) / (Max - Min)
                    Fill.Size = UDim2.new(a, 0, 1, 0)
                    Knob.Position = UDim2.new(a, -6, 0.5, -6)
                    ValueLabel.Text = tostring(Value)
                    if not silent then
                        task.spawn(Callback, Value)
                    end
                end

                local dragging = false
                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        local relX = (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
                        SetValue(relX)
                        PlaySound(Sounds.Click, 0.15)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        if dragging then
                            dragging = false
                            DoNotify(Notifications, "Slider Değiştirildi", Name .. " -> " .. tostring(Value))
                        end
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local relX = (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
                        SetValue(relX)
                    end
                end)

                SetValue((Default - Min) / (Max - Min), true)

                local API = { Instance = Frame }
                function API:Set(v)
                    SetValue((v - Min) / (Max - Min))
                end
                function API:Get()
                    return Value
                end
                return API
            end


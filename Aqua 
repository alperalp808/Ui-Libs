	local KeyFrame = Instance.new("Frame")
	KeyFrame.Size = UDim2.new(1, 0, 1, 0)
	KeyFrame.BackgroundColor3 = CurrentTheme.Background
	KeyFrame.BackgroundTransparency = 0.1
	KeyFrame.ClipsDescendants = true
	KeyFrame.Parent = KeyCanvas
	addCorner(KeyFrame, 10)
	addStroke(KeyFrame, CurrentTheme.Primary, 1.2, 0.3)

	local KHeader = Instance.new("Frame")
	KHeader.Size = UDim2.new(1, 0, 0, 35)
	KHeader.BackgroundColor3 = CurrentTheme.Header
	KHeader.BackgroundTransparency = 0.3
	KHeader.BorderSizePixel = 0
	KHeader.Parent = KeyFrame
	addCorner(KHeader, 10)

	local KHeaderFix = Instance.new("Frame")
	KHeaderFix.Size = UDim2.new(1, 0, 0, 10)
	KHeaderFix.Position = UDim2.new(0, 0, 1, -10)
	KHeaderFix.BackgroundColor3 = CurrentTheme.Header
	KHeaderFix.BackgroundTransparency = 0.3
	KHeaderFix.Parent = KHeader

	local KTitle = Instance.new("TextLabel")
	KTitle.Size = UDim2.new(1, -70, 1, 0)
	KTitle.Position = UDim2.new(0, 14, 0, 0)
	KTitle.BackgroundTransparency = 1
	KTitle.Text = string.upper((title or "SIGMA PROJECT") .. " // KEY SYSTEM")
	KTitle.Font = Enum.Font.RobotoMono
	KTitle.TextSize = 14 -- %20 Arttı
	KTitle.TextColor3 = CurrentTheme.Text
	KTitle.TextXAlignment = Enum.TextXAlignment.Left
	KTitle.TextTruncate = Enum.TextTruncate.AtEnd
	KTitle.Parent = KHeader

	-- Mobil ve PC için Sürükleme Desteği (Key System)
	local dragging, dragInput, dragStart, startPos
	KHeader.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = KeyCanvas.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	KHeader.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local delta = input.Position - dragStart
			KeyCanvas.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)

	-- Sağ Üst Köşeye Kapatma Tuşu (X)
	local KCloseBtn = Instance.new("TextButton")
	KCloseBtn.Size = UDim2.new(0, 24, 0, 22)
	KCloseBtn.Position = UDim2.new(1, -34, 0.5, -11)
	KCloseBtn.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
	KCloseBtn.BackgroundTransparency = 0.4
	KCloseBtn.Text = "X"
	KCloseBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
	KCloseBtn.Font = Enum.Font.GothamSSm
	KCloseBtn.TextSize = 14
	KCloseBtn.Parent = KHeader
	addCorner(KCloseBtn, 4)

	KCloseBtn.MouseButton1Click:Connect(function()
		playSound(SFX.Close, 0.6)
		local tw = TweenService:Create(KeyCanvas, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 360, 0, 0), GroupTransparency = 1})
		tw:Play()
		tw.Completed:Connect(function() ScreenGui:Destroy() end)
	end)

	local Body = Instance.new("Frame")
	Body.Size = UDim2.new(1, -32, 1, -45)
	Body.Position = UDim2.new(0, 16, 0, 40)
	Body.BackgroundTransparency = 1
	Body.Parent = KeyFrame

	local UserBox = Instance.new("TextBox")
	UserBox.Size = UDim2.new(1, 0, 0, 28)
	UserBox.Position = UDim2.new(0, 0, 0, 10)
	UserBox.BackgroundColor3 = Color3.fromRGB(24, 30, 38)
	UserBox.Text = ""
	UserBox.PlaceholderText = "Username"
	UserBox.PlaceholderColor3 = Color3.fromRGB(110, 115, 120)
	UserBox.TextColor3 = Color3.fromRGB(240, 245, 250)
	UserBox.Font = Enum.Font.GothamSSm
	UserBox.TextSize = 16 -- %20 Arttı
	UserBox.ClearTextOnFocus = false
	UserBox.Parent = Body
	addCorner(UserBox, 5)
	local UserStroke = addStroke(UserBox, Color3.fromRGB(255, 255, 255), 1, 0.9)

	local KeyBox = Instance.new("TextBox")
	KeyBox.Size = UDim2.new(1, 0, 0, 28)
	KeyBox.Position = UDim2.new(0, 0, 0, 48)
	KeyBox.BackgroundColor3 = Color3.fromRGB(24, 30, 38)
	KeyBox.Text = ""
	KeyBox.PlaceholderText = "Key"
	KeyBox.PlaceholderColor3 = Color3.fromRGB(110, 115, 120)
	KeyBox.TextColor3 = Color3.fromRGB(240, 245, 250)
	KeyBox.Font = Enum.Font.GothamSSm
	KeyBox.TextSize = 16 -- %20 Arttı
	KeyBox.ClearTextOnFocus = false
	KeyBox.Parent = Body
	addCorner(KeyBox, 5)
	local KeyStroke2 = addStroke(KeyBox, Color3.fromRGB(255, 255, 255), 1, 0.9)

	local LoginBtn = Instance.new("TextButton")
	LoginBtn.Size = UDim2.new(1, 0, 0, 30)
	LoginBtn.Position = UDim2.new(0, 0, 0, 86)
	LoginBtn.BackgroundColor3 = CurrentTheme.Primary
	LoginBtn.BackgroundTransparency = 0.75
	LoginBtn.Text = "GİRİŞ YAP"
	LoginBtn.TextColor3 = CurrentTheme.Primary
	LoginBtn.Font = Enum.Font.GothamSSm
	LoginBtn.TextSize = 16 -- %20 Arttı
	LoginBtn.AutoButtonColor = false
	LoginBtn.Parent = Body
	addCorner(LoginBtn, 6)
	addStroke(LoginBtn, CurrentTheme.Primary, 1.2, 0.4)

	local function shakeFrame(frame)
		local originalPos = frame.Position
		local offsets = {6, -6, 4, -4, 2, 0}
		task.spawn(function()
			for _, off in ipairs(offsets) do
				TweenService:Create(frame, TweenInfo.new(0.035, Enum.EasingStyle.Linear), {
					Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + off, originalPos.Y.Scale, originalPos.Y.Offset)
				}):Play()
				task.wait(0.035)
			end
			frame.Position = originalPos
		end)
	end

	local function wireBoxFocus(box, stroke)
		box.Focused:Connect(function()
			playSound(SFX.Hover, 0.2)
			TweenService:Create(stroke, TweenInfo.new(0.2), {Color = CurrentTheme.Primary, Transparency = 0.3}):Play()
		end)
		box.FocusLost:Connect(function()
			TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 255, 255), Transparency = 0.9}):Play()
		end)
	end
	wireBoxFocus(UserBox, UserStroke)
	wireBoxFocus(KeyBox, KeyStroke2)

	local attempting = false
	local function attemptLogin()
		if attempting then return end
		attempting = true
		playSound(SFX.Click, 0.5)

		local user = UserBox.Text
		local key = KeyBox.Text

		if user == "" or key == "" then
			Menu:Notify("Giriş Başarısız", "Kullanıcı adı ve key alanları boş bırakılamaz.", 4)
			shakeFrame(KeyFrame)
			attempting = false
			return
		end

		local loginSuccess = false

		-- Ahmet:1234 Sadullah:6767 gibi Eşleşmeli Sistem Kontrolü
		if config.Keys and type(config.Keys) == "table" then
			local targetKey = config.Keys[user] or config.Keys[string.lower(user)]
			if targetKey and tostring(targetKey) == key then
				loginSuccess = true
			end
		else
			-- Eski Tekli/Tablolu Klasik Kontrol
			local userOk = true
			if validUsernames then
				userOk = validUsernames[string.lower(user)] == true
			end
			local keyOk = false
			if #validKeys == 0 then
				keyOk = true
			else
				for _, k in pairs(validKeys) do
					if key == k then keyOk = true break end
				end
			end
			if userOk and keyOk then
				loginSuccess = true
			end
		end

		if not loginSuccess then
			Menu:Notify("Giriş Başarısız", "Kullanıcı adı veya key hatalı, tekrar deneyin.", 4)
			playSound(SFX.ToggleOff, 0.5)
			shakeFrame(KeyFrame)
			KeyBox.Text = ""
			attempting = false
			return
		end

		playSound(SFX.ToggleOn, 0.6)
		Menu:Notify("Erişim Onaylandı", "Hoş geldin " .. user .. ", menü açılıyor...", 3)

		if config.SaveKey then
			pcall(function() if writefile then writefile("AquaKeySystem_SavedKey.txt", key) end end)
		end

		local outTween = TweenService:Create(KeyCanvas, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1, Size = UDim2.new(0, 360, 0, 0)})
		outTween:Play()
		outTween.Completed:Connect(function() KeyCanvas:Destroy() end)

		self.KeySystemVerified = true
	end

	LoginBtn.MouseButton1Click:Connect(attemptLogin)
	UserBox.FocusLost:Connect(function(enterPressed) if enterPressed then attemptLogin() end end)
	KeyBox.FocusLost:Connect(function(enterPressed) if enterPressed then attemptLogin() end end)

	playSound(SFX.Open, 0.5)
	KeyCanvas.Size = UDim2.new(0, 360, 0, 0)
	TweenService:Create(KeyCanvas, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 360, 0, 210), GroupTransparency = 0}):Play()

	if config.SaveKey then
		pcall(function()
			if isfile and readfile and isfile("AquaKeySystem_SavedKey.txt") then
				local saved = readfile("AquaKeySystem_SavedKey.txt")
				if saved and saved ~= "" then KeyBox.Text = saved end
			end
		end)
	end
end

function Menu:CreateWindow(title, keyName, showButton, keySystemConfig)
	local self = setmetatable({}, Menu)

	keySystemConfig = keySystemConfig or {}
	-- Tema Seçimi Ataması
	if keySystemConfig.MenuTheme and Themes[keySystemConfig.MenuTheme] then
		CurrentTheme = Themes[keySystemConfig.MenuTheme]
	end

	local existing = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("AquaCSGO_PremiumMenu")
	if existing then existing:Destroy() end

	local ScreenGui = Instance.new("ScreenGui")

		local function updateToggle(forceState)
			if forceState ~= nil then state = forceState else state = not state end
			if state then playSound(SFX.ToggleOn, 0.5) else playSound(SFX.ToggleOff, 0.5) end
			TweenService:Create(Indicator, TweenInfo.new(0.2), {BackgroundColor3 = state and CurrentTheme.Primary or Color3.fromRGB(35, 42, 50)}):Play()
			TweenService:Create(Label, TweenInfo.new(0.2), {TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 165, 170)}):Play()

			InnerGlow.Size = UDim2.new(0,0,0,0)
			InnerGlow.Position = UDim2.new(0.5,0,0.5,0)
			InnerGlow.BackgroundTransparency = 0.3

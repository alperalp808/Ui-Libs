function Menu:_BuildKeyScreen(ScreenGui, title, validKeys, validUsernames, config)
	local KeyCanvas = Instance.new("CanvasGroup")
	KeyCanvas.Name = "KeyCanvas"
	KeyCanvas.Size = UDim2.new(0, 360, 0, 210) -- %30 Daha dar (300 -> 210)

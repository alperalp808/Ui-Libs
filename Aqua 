	ScreenGui.IgnoreGuiInset = true
	ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	self.ScreenGui = ScreenGui

	local keySystemEnabled = keySystemConfig.KeySystem or keySystemConfig.Enabled or false

	if keySystemEnabled then
		local validKeys = {}
		local keyField = keySystemConfig.Key or keySystemConfig.Unlockkey or keySystemConfig.UnlockKey
		if type(keyField) == "table" then
			for _, k in pairs(keyField) do table.insert(validKeys, tostring(k)) end
		elseif keyField then
			table.insert(validKeys, tostring(keyField))
		end

		local validUsernames = nil
		if keySystemConfig.Usernames then
			validUsernames = {}
			for _, u in pairs(keySystemConfig.Usernames) do validUsernames[string.lower(tostring(u))] = true end
		end

		self.KeySystemVerified = false
		self:_BuildKeyScreen(ScreenGui, title, validKeys, validUsernames, keySystemConfig)

		repeat task.wait() until self.KeySystemVerified
	end


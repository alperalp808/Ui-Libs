		local function updateSlider(input)
			local absWidth = Track.AbsoluteSize.X
			local absPos = Track.AbsolutePosition.X
			local relX = math.clamp(input.Position.X - absPos, 0, absWidth)
			local percent = relX / absWidth
			local rawVal = min + (percent * (max - min))
			local finalVal = math.floor(rawVal * 100) / 100
			Fill.Size = UDim2.new(percent, 0, 1, 0)
			ValueLabel.Text = tostring(finalVal)
			callback(finalVal)
		end

		local sliding = false
		Track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				updateSlider(input)
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				updateSlider(input)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = false
			end
		end)
	end

	function elements:AddDropdown(name, list, isMulti, callback)
		local dropped = false
		local selectedItems = {}
		if not isMulti then selectedItems = {list[1] or "None"} end

		local DropFrame = Instance.new("Frame")
		DropFrame.Size = UDim2.new(0.94, 0, 0, 48)
		DropFrame.BackgroundTransparency = 1
		DropFrame.Parent = SectionFrame

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(1, 0, 0, 16)
		Label.BackgroundTransparency = 1
		Label.Text = name
		Label.TextColor3 = activeTheme.TextSub
		Label.Font = Enum.Font.SourceSans
		Label.TextSize = 15
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Parent = DropFrame

		local ActionBtn = Instance.new("TextButton")
		ActionBtn.Size = UDim2.new(1, 0, 0, 28)
		ActionBtn.Position = UDim2.new(0, 0, 0, 20)
		ActionBtn.BackgroundColor3 = activeTheme.ElementBg
		ActionBtn.Text = "  " .. (isMulti and "Çoklu Seçim..." or tostring(selectedItems[1]))
		ActionBtn.TextColor3 = activeTheme.TextMain
		ActionBtn.Font = Enum.Font.SourceSansSemibold
		ActionBtn.TextSize = 15
		ActionBtn.TextXAlignment = Enum.TextXAlignment.Left
		ActionBtn.AutoButtonColor = false
		ActionBtn.Parent = DropFrame
		addCorner(ActionBtn, 5)

		local ListContainer = Instance.new("ScrollingFrame")
		ListContainer.Size = UDim2.new(1, 0, 0, 0)
		ListContainer.Position = UDim2.new(0, 0, 1, 2)
		ListContainer.BackgroundColor3 = activeTheme.MainBg
		ListContainer.ClipsDescendants = true
		ListContainer.ZIndex = 50
		ListContainer.ScrollBarThickness = 3
		ListContainer.ScrollBarImageColor3 = activeTheme.Accent
		ListContainer.CanvasSize = UDim2.new(0, 0, 0, #list * 24)
		ListContainer.Parent = ActionBtn
		addCorner(ListContainer, 5)

		local ListLayout = Instance.new("UIListLayout")
		ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
		ListLayout.Parent = ListContainer

		ActionBtn.MouseButton1Click:Connect(function()
			dropped = not dropped
			local targetHeight = dropped and math.clamp(#list * 24, 0, 140) or 0
			TweenService:Create(ListContainer, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
		end)

		for _, item in pairs(list) do
			local ItemBtn = Instance.new("TextButton")
			ItemBtn.Size = UDim2.new(1, 0, 0, 24)
			ItemBtn.BackgroundTransparency = 1
			ItemBtn.Text = "  " .. tostring(item)
			ItemBtn.TextColor3 = activeTheme.TextMain
			ItemBtn.Font = Enum.Font.SourceSans
			ItemBtn.TextSize = 14
			ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
			ItemBtn.ZIndex = 55
			ItemBtn.Parent = ListContainer

			ItemBtn.MouseButton1Click:Connect(function()
				if not isMulti then
					ActionBtn.Text = "  " .. tostring(item)
					dropped = false
					ListContainer.Size = UDim2.new(1, 0, 0, 0)
					callback(item)
				end
			end)
		end
	end

	return elements
end

return Menu

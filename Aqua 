		local originalPos = frame.Position
		local offsets = {6, -6, 4, -4, 2, 0}
		task.spawn(function()
			for _, off in ipairs(offsets) do
				TweenService:Create(frame, TweenInfo.new(0.035, Enum.EasingStyle.Linear), {
					Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + off, originalPos.Y.Scale, originalPos.Y.Offset)
				}):Play()
				task.wait(0.035)
			end
			frame.Position = originalPos
		end)
	end

	local function wireBoxFocus(box, stroke)
		box.Focused:Connect(function()
			playSound(SFX.Hover, 0.2)
			TweenService:Create(stroke, TweenInfo.new(0.2), {Color = activeTheme.Accent, Transparency = 0.3}):Play()
		end)
		box.FocusLost:Connect(function()
			TweenService:Create(stroke, TweenInfo.new(0.2), {Color = activeTheme.TextSub, Transparency = 0.8}):Play()
		end)
	end
	wireBoxFocus(UserBox, UserStroke)
	wireBoxFocus(KeyBox, KeyStroke2)

	local attempting = false
	local function attemptLogin()
		if attempting then return end
		attempting = true
		playSound(SFX.Click, 0.5)

		local user = UserBox.Text
		local key = KeyBox.Text

		if user == "" or key == "" then
			Menu:Notify("Giriş Başarısız", "Kullanıcı adı ve key alanları boş bırakılamaz.", 4)
			shakeFrame(KeyFrame)
			attempting = false
			return
		end

		-- Belirli Kullanıcılar İçin Birebir Anahtar Eşleşme Kontrolü (Ahmet:1234, Sadullah:6767)
		local exactMatch = credentials[user]
		if exactMatch and tostring(exactMatch) == key then
			-- Giriş başarılı
		else
			Menu:Notify("Giriş Başarısız", "Kullanıcı adı veya key eşleşmesi hatalı.", 4)
			playSound(SFX.ToggleOff, 0.5)
			shakeFrame(KeyFrame)
			KeyBox.Text = ""
			attempting = false
			return
		end

		playSound(SFX.ToggleOn, 0.6)
		Menu:Notify("Erişim Onaylandı", "Hoş geldin " .. user .. ", menü açılıyor...", 3)

		if config.SaveKey then
			pcall(function()
				if writefile then
					writefile("AquaKeySystem_SavedKey.txt", user .. ":" .. key)
				end
			end)
		end

		local outTween = TweenService:Create(KeyCanvas, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1, Size = UDim2.new(0, 360, 0, 0)})
		outTween:Play()
		outTween.Completed:Connect(function()
			KeyCanvas:Destroy()
		end)

		self.KeySystemVerified = true
	end

	LoginBtn.MouseButton1Click:Connect(attemptLogin)

	playSound(SFX.Open, 0.5)
	KeyCanvas.Size = UDim2.new(0, 360, 0, 0)
	TweenService:Create(KeyCanvas, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 360, 0, 210), GroupTransparency = 0}):Play()

	if config.SaveKey then
		pcall(function()
			if isfile and readfile and isfile("AquaKeySystem_SavedKey.txt") then
				local saved = readfile("AquaKeySystem_SavedKey.txt")
				if saved and saved ~= "" then
					local split = string.split(saved, ":")
					if split[1] and split[2] then
						UserBox.Text = split[1]
						KeyBox.Text = split[2]
					end
				end
			end
		end)
	end
end

function Menu:CreateWindow(title, keyName, showButton, keySystemConfig)
	local self = setmetatable({}, Menu)

	-- Tema Seçimi (Parametreden gelen MenuTheme verisine göre ayarlanır, yoksa Aqua)
	keySystemConfig = keySystemConfig or {}
	local selectedThemeName = keySystemConfig.MenuTheme or "Aqua"
	local activeTheme = Themes[selectedThemeName] or Themes.Aqua
	self.SelectedTheme = activeTheme

	local existing = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("AquaCSGO_PremiumMenu")
	if existing then existing:Destroy() end

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "AquaCSGO_PremiumMenu"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	ScreenGui.DisplayOrder = 9999
	ScreenGui.IgnoreGuiInset = true
	ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	self.ScreenGui = ScreenGui

	local keySystemEnabled = keySystemConfig.KeySystem or keySystemConfig.Enabled or false
	local configWrapper = {
		Note = keySystemConfig.Note,
		SaveKey = keySystemConfig.SaveKey,
		DefaultToggleKey = Enum.KeyCode[keyName or "RightShift"]
	}

	if keySystemEnabled then
		-- Kullanıcı Adı ve Şifre Listesi Tablosu Düzenlemesi
		local credentials = {}
		if type(keySystemConfig.Credentials) == "table" then
			for u, k in pairs(keySystemConfig.Credentials) do
				credentials[tostring(u)] = tostring(k)
			end
		elseif keySystemConfig.Key then
			credentials["Admin"] = tostring(keySystemConfig.Key)
		end

		self.KeySystemVerified = false
		self:_BuildKeyScreen(ScreenGui, title, credentials, configWrapper, activeTheme)

		repeat task.wait() until self.KeySystemVerified
	end

	-- Global Kapatma/Açma Tuşu Güncellemesi
	self.GlobalToggleKey = configWrapper.DefaultToggleKey


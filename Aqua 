		function toggleObject:AddKeybind(keyString, internalCallback)
			local keyCode = Enum.KeyCode[keyString]
			createKeybindEngine(ToggleFrame, name, keyCode, function(tState)
				updateToggle(tState)
				if internalCallback then internalCallback(tState) end
			end)
		end
		return toggleObject
	end


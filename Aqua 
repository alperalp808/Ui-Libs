		local function toggleDropdown()
			dropped = not dropped
			playSound(SFX.Click, 0.4)

			if dropped then
				parentZone.ZIndex = 10
				SectionFrame.ZIndex = 10
				DropFrame.ZIndex = 10
				ActionBtn.ZIndex = 11
			else
				task.delay(0.25, function()
					if not dropped then
						parentZone.ZIndex = 1
						SectionFrame.ZIndex = 2
						DropFrame.ZIndex = 5
						ActionBtn.ZIndex = 6
					end
				end)
			end

			local targetHeight = dropped and math.clamp(#list * ITEM_HEIGHT, 0, MAX_LIST_HEIGHT) or 0
			TweenService:Create(ListContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
			TweenService:Create(Arrow, TweenInfo.new(0.2), {Rotation = dropped and 180 or 0, TextColor3 = dropped and CurrentTheme.Primary or Color3.fromRGB(120, 125, 130)}):Play()

			if dropped then ListContainer.CanvasPosition = Vector2.new(0, 0) end
		end

		ActionBtn.MouseButton1Click:Connect(toggleDropdown)

		for _, item in pairs(list) do
			local ItemBtn = Instance.new("TextButton")
			ItemBtn.Size = UDim2.new(1, 0, 0, ITEM_HEIGHT)
			ItemBtn.BackgroundColor3 = CurrentTheme.Primary
			ItemBtn.BackgroundTransparency = 1
